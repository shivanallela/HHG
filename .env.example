# =============================================================================
# HH Goa 2026 — Voice-Enabled RAG Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Dataset Configuration ---
DATASET_NAME=ai4bharat/MSMARCO-XI
DATASET_CONFIG=hi
DATASET_SPLIT=train
DATASET_SAMPLE_SIZE=10000

# --- API Keys (Voice) ---
SARVAM_API_KEY=
ELEVENLABS_API_KEY=

# --- LLM Configuration ---
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3

# --- Embedding Configuration ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector Database ---
VECTOR_DB_PATH=data/processed/faiss_index

# --- Flask Configuration ---
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=logs
